# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google Maps + Places (Autocomplete im Onboarding)
# APIs für diesen Browser-Key aktivieren:
# - Maps JavaScript API
# - Places API (Legacy) ODER Places API (New)
#
# Application restriction = HTTP referrers (web sites), z. B.:
#   http://localhost:8080/*
#   http://127.0.0.1:8080/*
#   https://DEINE-PRODUKTIONS-DOMAIN/*
# Nie „None“ / IP-Restriction für diesen Frontend-Key.
# Alten geleakten Key in GCP löschen und hier den neuen eintragen (nie committen).
VITE_GOOGLE_MAPS_API_KEY=

# Integrationstests gegen die Remote-Supabase-Instanz (npm run test:integration).
# Gehören ausschließlich in die gitignorierte .env.test, niemals hierher oder in Code/Doku.
# Nur dedizierte Testaccounts verwenden – niemals Produktiv- oder Kundenzugänge.
# Fehlen die Werte, überspringt der Integrationstest sich selbst (skip statt fail).
# E2E_DRIVER_EMAIL=fahrer@example.test
# E2E_DRIVER_PASSWORD=<nur-lokal-in-.env.test>
# E2E_DRIVER_ID=<uuid-des-fahrerdatensatzes>
# Optional Dispatcher für Playwright (npm run test:e2e):
# E2E_DISPATCHER_EMAIL=dispatcher@example.test
# E2E_DISPATCHER_PASSWORD=<nur-lokal-in-.env.test>
# Optional, sonst heutiges Datum bzw. 3:
# E2E_DRIVER_TOUR_DATE=2026-01-31
# E2E_DRIVER_TOUR_STOP_COUNT=3

# Edge Secret (Supabase Dashboard → Edge Functions → Secrets), nicht Vite:
# GOOGLE_MAPS_API_KEY — für assign-depot / Distance Matrix (Server-Key, IP- oder ohne Browser-Referrer).
# Ohne dieses Secret fällt assign-depot automatisch auf Haversine zurück.
# GEMINI_API_KEY — für ai-resolve sowie Google-Search-Grounding + Extraktion in research-article.
# Optional: SERPER_API_KEY oder TAVILY_API_KEY als alternative Suchprovider.
