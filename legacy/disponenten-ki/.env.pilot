# Pilot-Konfiguration – Easy Planning (Vorlage)
# Kopieren nach .env und Werte anpassen. Nicht mit echten Secrets ins Repository committen.

# --- Datenbank ---
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# --- Auth / JWT ---
SECRET_KEY=change-me-long-random-string
# EASYPLAN_REQUIRE_AUTH=1

# --- E-Mail-Intake (IMAP) ---
EMAIL_IMAP_ENABLED=true
EMAIL_IMAP_HOST=imap.example.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_TLS=true
EMAIL_IMAP_USER=lieferschein@firma.de
EMAIL_IMAP_PASSWORD=
EMAIL_DEFAULT_COMPANY_ID=
EMAIL_POLL_INTERVAL_MS=120000

# --- SMTP (Bestätigungsmail nach Freigabe) ---
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_FROM=
EMAIL_CONFIRM_ENABLED=true

# --- Logging / Monitoring ---
LOG_LEVEL=INFO
LOG_FORMAT=json
STRUCTURED_LOG=1
SLOW_REQUEST_WARN_MS=1000
SLOW_REQUEST_ERROR_MS=3000

# Optional: Sentry
# SENTRY_DSN=
