# Easy Planning – Umgebungsvariablen
# Kopiere diese Datei zu .env und passe die Werte an.
# NIEMALS echte Secrets in .env.example eintragen!

# ---------------------------------------------------------------------------
# Datenbank
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://easy:easy@localhost:5432/easyplanning

# ---------------------------------------------------------------------------
# Auth & Sicherheit
# ---------------------------------------------------------------------------
# WICHTIG: In Produktion einen langen, zufälligen String verwenden!
# Beispiel: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=BITTE-AENDERN-IN-PRODUKTION-min-32-zeichen

# Entwicklungsmodus: kein Login erforderlich (NUR lokal, NIEMALS in Produktion!)
EASYPLAN_DEV=0

# Legacy-Override: Auth explizit an (1) oder aus (0). Standard ist 1 (sicher).
EASYPLAN_REQUIRE_AUTH=1

# ---------------------------------------------------------------------------
# ETA / Routenoptimierung
# ---------------------------------------------------------------------------
# "auto"     = versuche OSRM, Fallback auf Manhattan (empfohlen)
# "osrm"     = nur OSRM (schlägt fehl wenn nicht erreichbar)
# "manhattan"= immer Manhattan (Demo/Offline)
EASYPLAN_ETA_PROVIDER=auto

# Öffentliches OSRM (Demo). Für Produktion eigenen Server aufsetzen!
EASYPLAN_OSRM_URL=https://router.project-osrm.org
EASYPLAN_OSRM_PROFILE=driving
EASYPLAN_OSRM_TIMEOUT_S=4.0
EASYPLAN_OSRM_MAX_LOCATIONS=80

# Koordinatenzentrum (für Demo-Grid-Modus, Legacy)
EASYPLAN_OSRM_CENTER_LAT=50.11
EASYPLAN_OSRM_CENTER_LON=8.68
EASYPLAN_OSRM_GRID_SCALE=0.005

# ---------------------------------------------------------------------------
# E-Mail-Eingang (optional, IMAP)
# ---------------------------------------------------------------------------
# EMAIL_IMAP_ENABLED=1
# EMAIL_IMAP_HOST=imap.example.com
# EMAIL_IMAP_PORT=993
# EMAIL_IMAP_USER=disposition@example.com
# EMAIL_IMAP_PASSWORD=geheimes-passwort
# EMAIL_DEFAULT_COMPANY_ID=<uuid>
# EMAIL_POLL_INTERVAL_MS=60000
# EMAIL_CONFIRM_ENABLED=1
